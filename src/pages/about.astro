---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';

// 静态页面没有 render() 给的 headings，目录要自己写。
// 注意 slug 必须和下面 <h2> 的 id 一致，改标题时两处一起改。
const toc = [{ depth: 2, slug: '联系我', text: '联系我' }];
---

<BaseLayout title="关于" description={`关于 ${SITE.author}`} toc={toc}>
	<h1 class="page-title">关于</h1>

	<div class="prose">
		<p>
			哈喽! <strong>{SITE.author}</strong>。这里放我的学习笔记和一些项目记录，
			主要是为了逼自己把学过的东西写清楚 —— 能写明白的，才算真的懂了。
		</p>

		<h2 id="联系我">联系我</h2>
		<ul>
			<li>GitHub：<a href="https://github.com/Ekko-OH">@Ekko-OH</a></li>
		</ul>
	</div>
</BaseLayout>
