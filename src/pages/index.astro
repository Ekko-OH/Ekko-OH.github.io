---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteCard from '../components/NoteCard.astro';
import { SITE } from '../site.config';
import { getHumanNotes } from '../lib/notes';

const notes = await getHumanNotes();
const overview = notes.find((note) => note.data.role === 'overview');
const recent = notes.filter((note) => note.id !== overview?.id).slice(0, 5);
---

<BaseLayout>
	<section class="hero">
		<h1>{SITE.tagline}</h1>
		<p>{SITE.description}</p>
	</section>

	{
		overview && (
			<section class="section">
				<div class="section-head">
					<h2>从总览开始</h2>
					<a href="/graph/">知识图谱 →</a>
				</div>
				<ul class="note-list">
					<NoteCard note={overview} />
				</ul>
			</section>
		)
	}

	<section class="section">
		<div class="section-head">
			<h2>最近更新</h2>
			<a href="/notes/">个人笔记 {notes.length} 篇 →</a>
		</div>
		{
			recent.length === 0 ? (
				<p class="empty">还没有新的专题或模型笔记。去 Obsidian 写一篇，加 <code>publish: true</code> 后同步过来。</p>
			) : (
				<ul class="note-list">
					{recent.map((note) => (
						<NoteCard note={note} />
					))}
				</ul>
			)
		}
	</section>
</BaseLayout>
