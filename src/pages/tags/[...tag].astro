---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import { collectTags, getHumanNotes, type Note } from '../../lib/notes';

export async function getStaticPaths() {
	const notes = await getHumanNotes();
	return collectTags(notes).map(({ tag, count }) => ({
		params: { tag },
		props: { tag, count, items: notes.filter((note) => note.data.tags.includes(tag)) },
	}));
}

interface Props {
	tag: string;
	count: number;
	items: Note[];
}

const { tag, count, items } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`标签 ${tag} 下的 ${count} 篇笔记`}>
	<h1 class="page-title">#{tag}</h1>
	<p class="note-meta" style="margin-top: -1rem; margin-bottom: 1.5rem;">{count} 篇笔记</p>

	<ul class="note-list">
		{items.map((note) => <NoteCard note={note} />)}
	</ul>

	<p style="margin-top: 2rem;"><a href="/tags/">← 全部标签</a></p>
</BaseLayout>
