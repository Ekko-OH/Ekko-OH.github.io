---
import '@fontsource-variable/inter';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { Icon } from 'astro-icon/components';
import Sidebar from '../components/Sidebar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Signature from '../components/Signature.astro';
import { SITE, NAV } from '../site.config';

interface Props {
	/** 页面标题，不传就用站点名 + 副标题 */
	title?: string;
	description?: string;
	/** 当前页面的分节目录；不传或为空就不渲染左侧栏 */
	toc?: { depth: number; slug: string; text: string }[];
	/** 需要更宽画布的页面（知识图谱）用，正文列放宽到 60rem */
	wide?: boolean;
}

const { title, description = SITE.description, toc = [], wide = false } = Astro.props;
const hasToc = toc.length > 0;
const year = new Date().getFullYear();
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<!-- 必须放在下面的主题脚本之前，否则脚本找不到它 -->
		<meta name="theme-color" content="#ffffff" />
		<script is:inline>
			// 在首屏绘制前决定主题，避免闪一下再变色。
			// 优先用用户手动选过的，其次跟随系统。
			(function () {
				var root = document.documentElement;
				var media = window.matchMedia('(prefers-color-scheme: dark)');

				function chosen() {
					try {
						var value = localStorage.getItem('theme');
						return value === 'light' || value === 'dark' ? value : null;
					} catch (error) {
						return null; // 隐私模式下读不到，当作没选过
					}
				}

				function apply(theme) {
					root.setAttribute('data-theme', theme);
					var meta = document.querySelector('meta[name="theme-color"]');
					if (meta) {
						meta.setAttribute('content', theme === 'dark' ? '#0e1013' : '#ffffff');
					}
				}

				function effective() {
					return chosen() || (media.matches ? 'dark' : 'light');
				}

				apply(effective());

				// 没手动选过时，跟随系统变化
				media.addEventListener('change', function () {
					if (!chosen()) apply(effective());
				});

				// 事件委托，按钮还没解析出来也能用
				document.addEventListener('click', function (event) {
					var target = event.target;
					if (!target || typeof target.closest !== 'function') return;
					if (!target.closest('#theme-toggle')) return;

					var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
					try {
						localStorage.setItem('theme', next);
					} catch (error) {
						// 存不了就算了，本次切换照常生效
					}
					apply(next);
				});
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
	</head>
	<body>
		<!-- 梅枝背景：铺满视口、压在内容下面，正中用径向遮罩擦干净保证可读性 -->
		<div class="art-plum" aria-hidden="true">
			<canvas data-art-plum></canvas>
		</div>

		<header class="site-header">
			<div class="bar header-inner">
				<Signature />
				<div class="header-actions">
					<nav>
						{
							NAV.map((item) => (
								<a
									href={item.href}
									class:list={['nav-link', { active: isActive(item.href) }]}
									aria-current={isActive(item.href) ? 'page' : undefined}
									aria-label={item.label}
									title={item.label}
								>
									<Icon name={item.icon} aria-hidden="true" />
								</a>
							))
						}
					</nav>
					<ThemeToggle />
				</div>
			</div>
		</header>

		<div class:list={['shell', { 'shell-with-toc': hasToc }]}>
			{hasToc && <Sidebar toc={toc} />}
			<main class:list={['wrap', { 'wrap-wide': wide }]}>
				<slot />
			</main>
		</div>

		<footer class="site-footer">
			<div class="bar">
				<p>
					© {year} {SITE.author} · 用 <a href="https://astro.build">Astro</a> 构建，托管在 <a
						href="https://pages.github.com">GitHub Pages</a
					>
				</p>
			</div>
		</footer>

		<script>
			import { initPlumArt } from '../scripts/art-plum';
			initPlumArt();
		</script>
	</body>
</html>
