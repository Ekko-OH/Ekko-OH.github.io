---

<a class="signature" href="/" aria-label={`${SITE.title} 首页`} title={SITE.title}>
	<svg
		class="signature-svg"
		viewBox="0 0 1487 381"
		aria-hidden="true"
		focusable="false"
		shape-rendering="geometricPrecision"
	>
		{
			strokes.map((stroke) => (
				<path class="signature-stroke" d={stroke.d} data-group={stroke.group} />
			))
		}
	</svg>
</a>

<script is:inline>
	(() => {
		const svg = document.querySelector('.signature-svg');
		if (!svg) return;
		const strokes = [...svg.querySelectorAll('.signature-stroke')];
		if (!strokes.length) return;

		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		const lengths = strokes.map((stroke) => stroke.getTotalLength());
		const longest = Math.max(...lengths);
		const animations = [];
		let timer = 0;

		function play() {
			for (const animation of animations) animation.cancel();
			animations.length = 0;

			for (let i = 0; i < strokes.length; i += 1) {
				strokes[i].style.opacity = '0.88';
				strokes[i].style.strokeDasharray = `${lengths[i]} ${lengths[i]}`;
				strokes[i].style.strokeDashoffset = `${lengths[i]}`;
			}

			let start = 0;
			let previousGroup = '';
			for (let i = 0; i < strokes.length; i += 1) {
				const stroke = strokes[i];
				if (previousGroup && stroke.dataset.group !== previousGroup) start += 90;

				const duration = 150 + (lengths[i] / longest) * 330;
				animations.push(
					stroke.animate(
						[
							{ strokeDashoffset: lengths[i] },
							{ strokeDashoffset: 0 },
						],
						{
							duration,
							delay: start,
							fill: 'both',
							easing: 'cubic-bezier(0.35, 0, 0.25, 1)',
						},
					),
				);

				start += duration;
				previousGroup = stroke.dataset.group;
			}

			const hold = 1800;
			const fade = 450;
			const gap = 420;
			for (const stroke of strokes) {
				animations.push(
					stroke.animate(
						[{ opacity: 0.88 }, { opacity: 0 }],
						{ duration: fade, delay: start + hold, fill: 'both' },
					),
				);
			}

			window.clearTimeout(timer);
			timer = window.setTimeout(play, start + hold + fade + gap);
		}

		play();
	})();
</script>
