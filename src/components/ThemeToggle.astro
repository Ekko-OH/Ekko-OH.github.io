---
/**
 * 主题切换按钮。
 *
 * 只用画图标和提供点击目标 —— 初始主题由 BaseLayout 里的内联脚本
 * 在首屏绘制前决定，点击处理也放在那里（用事件委托），所以这里不需要 JS。
 */
---

<button
	type="button"
	id="theme-toggle"
	class="theme-toggle"
	aria-label="切换深色 / 浅色主题"
	title="切换深色 / 浅色主题"
>
	<svg
		class="icon-moon"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
	</svg>
	<svg
		class="icon-sun"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
		></path>
	</svg>
</button>
