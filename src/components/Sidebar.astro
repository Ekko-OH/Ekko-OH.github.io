---
/**
 * 左侧栏：**当前页面的分节目录**（h2 / h3），不是全站导航。
 *
 * 目录由页面传进来：
 *   - Markdown 笔记页：render() 返回的 headings
 *   - 静态页面（如 about.astro）：页面自己写死的数组
 * 没有小标题的页面不渲染这个组件（BaseLayout 里判断）。
 */
import { Icon } from 'astro-icon/components';

interface Props {
	toc: { depth: number; slug: string; text: string }[];
}

const { toc } = Astro.props;

// 只列最上面两层（一般是 h2 + h3），再往下列侧栏就太长了
const minDepth = toc.length > 0 ? Math.min(...toc.map((item) => item.depth)) : 2;
const items = toc.filter((item) => item.depth <= minDepth + 1);
---

<aside class="sidebar" aria-label="本页目录">
	<div class="sidebar-head">
		<Icon name="lucide:list-tree" aria-hidden="true" />
		<span>目录</span>
	</div>
	<ul class="tree">
		{
			items.map((item) => (
				<li class:list={['toc-item', `toc-depth-${item.depth - minDepth}`]}>
					<a class="tree-link" href={`#${item.slug}`}>
						{item.text}
					</a>
				</li>
			))
		}
	</ul>
</aside>
